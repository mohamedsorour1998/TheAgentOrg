# Copy to .env and fill in. Only Sorour needs the AWS values.

# --- AWS / Bedrock (Sorour) ---
AWS_REGION=us-east-1
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0

# --- LLM fallback (optional; leave blank to use Bedrock) ---
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_MODEL=us.amazon.nova-2-lite-v1:0

# --- Pipeline behaviour ---
SECURITY_BLOCK_THRESHOLD=high
MAX_REVISION_LOOPS=3

# Set true to run the whole demo with the network off (plain local git).
OFFLINE=false

# --- GitHub (Mariam) ---
# Both are required to open real PRs. If either is blank, github_ops falls back
# to local:// refs and no PR is opened — the pipeline still runs green.
#
# Token: a classic PAT with `repo` scope, or just reuse the GitHub CLI's:
#   GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
# The shared target repo the pipeline opens PRs against. You need write access.
DEMO_REPO=mohamedsorour1998/auth-service
