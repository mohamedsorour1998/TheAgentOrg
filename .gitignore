# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.venv-*/
*.egg-info/
build/
dist/

# Env / secrets
.env
*.tfvars

# Terraform
.terraform/
# `data.archive_file` writes the Lambda zip here at PLAN time, so any local
# `terraform plan` would otherwise leave an untracked build artifact in
# `git status`. `build/` above does not match a dot-prefixed directory.
infra/Terraform/modules/*/.build/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Pipeline run artifacts (logs + paused state)
runs/
runs-archive-*/
build/
dist/

.claude/
.superpowers/
# The team's personal photographs. The SQUARE crops under docs/pitch/photos/square/ are
# committed because the deck embeds them and it must build on anyone's machine; the
# originals are not ours to redistribute and are large.
docs/pitch/photos/*.jpeg
docs/pitch/photos/*.png
docs/pitch/photos/*.jpg
!docs/pitch/photos/square/

# PowerPoint's lock file, created while a deck is open in the app. Committed once by
# accident; it is a transient artifact of an editor, not a deliverable.
~$*.pptx

# macOS Finder metadata. Committed once by accident via `git add -A`.
.DS_Store
**/.DS_Store
